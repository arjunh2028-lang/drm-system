# Copy this file to .env and fill in real values before running the server.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=drm_system

# --- Auth ---
# Use a long random string in real deployments. This is only a dev default.
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=1d

# --- File upload ---
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_MB=25

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
