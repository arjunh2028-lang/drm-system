{
  "name": "drm-backend",
  "version": "1.0.0",
  "description": "DRM System V3 - Express/MySQL backend with versioned encrypted content protection",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test",
    "convert:legacy-content": "node scripts/convert_legacy_content.js",
    "migrate:v2": "node scripts/migrate_v2.js",
    "migrate:v3": "node scripts/migrate_v3.js",
    "rotate:keks": "node scripts/rotate_keks.js",
    "reconcile:blockchain": "node scripts/reconcile_blockchain_operations.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
