# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment secrets
.env
backend/.env
frontend/.env

# Build output
frontend/dist/
frontend/build/

# Uploaded user content (keep the folder, ignore what's uploaded at
# runtime through the app; the pre-committed sample-* files used for
# the demo are explicitly kept via the negated patterns below)
uploads/*
!uploads/.gitkeep
!uploads/sample-*

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
